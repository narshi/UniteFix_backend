{
  "expo": {
    "name": "UniteFix",
    "slug": "unitefix-mobile",
    "scheme": "unitefix",
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/app_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "UniteFix needs your location to show nearby services and set your address.",
        "NSLocationAlwaysUsageDescription": "UniteFix uses your location in the background to help partners reach your address."
      }
    },
    "android": {
      "package": "com.unitefix.app",
      "versionCode": 22,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a1628"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon_trimmed.png",
          "color": "#4F46E5",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "UniteFix needs your location to show nearby services."
        }
      ],
      [
        "./plugins/withTruecaller",
        {
          "clientId": "4gniidv8yotvmqym7nwgcfven6mk36mqep70ikeq8qs"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "gmp-demo-project-687518846"
      }
    }
  }
}