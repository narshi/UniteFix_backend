# Copy to keystore.properties (same folder) and fill in. keystore.properties is
# not tracked in git; this example is safe to commit.
#
# app/build.gradle reads these two names from keystore.properties first, then
# from environment variables of the same name (CI), then from a Gradle property
# (for example ~/.gradle/gradle.properties).
#
# The keystore file name and key alias are not secret and stay in
# gradle.properties: MYAPP_UPLOAD_STORE_FILE, MYAPP_UPLOAD_KEY_ALIAS.
MYAPP_UPLOAD_STORE_PASSWORD=
MYAPP_UPLOAD_KEY_PASSWORD=
